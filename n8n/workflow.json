{
  "name": "Parser Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pipeline",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Webhook: receive files",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-800, 0],
      "webhookId": "pipeline"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst inbox = '/data/inbox';\nfs.rmSync(inbox, {recursive: true, force: true});\nfs.mkdirSync(inbox, {recursive: true});\n\nconst items = $input.all();\nlet saved = 0;\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  if (item.binary) {\n    for (const [key, b] of Object.entries(item.binary)) {\n      const name = b.fileName || ('upload_' + saved);\n      const buf = await helpers.getBinaryDataBuffer(i, key);\n      fs.writeFileSync(path.join(inbox, name), buf);\n      saved++;\n    }\n  }\n}\nreturn [{json: {saved_to_inbox: saved}}];"
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Save uploads to inbox",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-580, 0]
    },
    {
      "parameters": {
        "command": "python3 /opt/scripts/pipeline/01_normalize.py --inbox /data/inbox --out /data/staging"
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "Stage 1: normalize",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "command": "python3 /opt/scripts/pipeline/02_parse.py --staging /data/staging --out /data/parsed.json"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "Stage 2: parse",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "command": "python3 /opt/scripts/pipeline/03_generate.py --json /data/parsed.json --out /data/out/Report.xlsx --switch-dir /data/staging/switches"
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "Stage 3: generate",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [80, 0]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst p = '/data/out/Report.xlsx';\nconst buf = fs.readFileSync(p);\nconst binaryData = await helpers.setBinaryDataBuffer(\n  {\n    mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n    fileName: 'Report.xlsx',\n  },\n  buf\n);\nreturn [{\n  json: {file: 'Report.xlsx'},\n  binary: { data: binaryData },\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000006",
      "name": "Attach xlsx",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 0]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "Respond with xlsx",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0]
    }
  ],
